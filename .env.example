# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local ni ningún archivo con llaves reales al repositorio (es público).

# Supabase: URL y llave pública (anon). En local, las imprime `pnpm supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave con permisos totales (ignora RLS). Solo la usan src/lib/supabase/admin.ts (eliminación de
# cuentas), los scripts y las pruebas. NUNCA debe tener el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, usada en los enlaces de los mensajes de WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (plan gratuito). Opcionales en local; si están vacíos no se envían errores.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps durante el build en Vercel.
SENTRY_AUTH_TOKEN=
